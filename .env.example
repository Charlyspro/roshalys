SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# En produccion: DEBUG=False y ALLOWED_HOSTS con el dominio .wasmer.app
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.wasmer.app
STORE_NAME=ROSHALYS
STORE_LOGO=ROSHALYS
STORE_CURRENCY=USD
ADMIN_EMAIL=admin@roshalys.local
WHATSAPP_NUMBERS=54279546,55502491
PRIMARY_COLOR=#0f766e
SECONDARY_COLOR=#f59e0b
BACKGROUND_COLOR=#f8fafc
TEXT_COLOR=#1f2937
BUTTON_COLOR=#0f766e
# Base de datos (sqlite3 | postgresql | mysql)
# En Wasmer Edge usa mysql y los valores se inyectan automáticamente
# (DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT cuando se auto-detecta MySQL).
DATABASE_ENGINE=sqlite3
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Variables de Wasmer Edge (auto-inyectadas si hay MySQL):
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT
CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@roshalys.local
