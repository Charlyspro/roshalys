SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
# En produccion: DEBUG=False y ALLOWED_HOSTS con el dominio .wasmer.app
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.wasmer.app
STORE_NAME=ROSHALYS
STORE_LOGO=ROSHALYS
STORE_CURRENCY=USD
ADMIN_EMAIL=admin@roshalys.local
WHATSAPP_NUMBERS=5354279546,5355502491
PRIMARY_COLOR=#1E3A8A
SECONDARY_COLOR=#F97316
BACKGROUND_COLOR=#F3F4F6
TEXT_COLOR=#1F2937
BUTTON_COLOR=#F97316
# Base de datos (sqlite3 | postgresql | mysql)
# En Wasmer Edge usa mysql y los valores se inyectan automáticamente
# (DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT cuando se auto-detecta MySQL).
DATABASE_ENGINE=sqlite3
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Variables de Wasmer Edge (auto-inyectadas si hay MySQL):
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, DB_PORT
CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@roshalys.local
OLLAMA_ENABLED=False
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT=45
